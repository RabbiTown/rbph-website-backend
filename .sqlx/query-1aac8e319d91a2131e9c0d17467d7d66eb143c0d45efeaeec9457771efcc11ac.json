  "query": "INSERT INTO rb_puzzle_backend (puzzle_id, enabled, source)\n        VALUES ($1, FALSE, $2)\n        ON CONFLICT (puzzle_id)\n        DO UPDATE SET\n            source = EXCLUDED.source,\n            utime_at = CURRENT_TIMESTAMP\n        RETURNING puzzle_id, enabled, source, ctime_at, utime_at",
