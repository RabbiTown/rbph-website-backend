{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.slug, p.title, p.ptype, p.content, p.content_type,\n                p.round_id, r.slug AS round_slug, r.title AS round_title, r.game_id\n        FROM rb_puzzle p\n        JOIN rb_round r ON r.id = p.round_id AND r.puzzle IS DISTINCT FROM p.id\n        WHERE p.id = $1;",
