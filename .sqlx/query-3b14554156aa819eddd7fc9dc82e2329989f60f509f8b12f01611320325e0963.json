  "query": "SELECT t.state, t.pass, t.game_id,\n            COALESCE((SELECT gf.state = 1 FROM rb_game_feature gf\n                WHERE gf.game_id = t.game_id AND gf.feature_type = 0), TRUE) AS \"team_open!\"\n        FROM rb_team t\n        WHERE id = $1\n        FOR UPDATE;",
