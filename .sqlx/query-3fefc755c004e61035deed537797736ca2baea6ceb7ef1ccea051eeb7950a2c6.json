  "query": "SELECT u.id, m.is_captain, u.nickname, u.email, u.avatar_provider, m.ctime_at\n        FROM rb_team_member m\n        JOIN rb_user u ON u.id = m.user_id\n        WHERE m.team_id = $1\n        ORDER BY m.is_captain DESC, m.ctime_at ASC;",
