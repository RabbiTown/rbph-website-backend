{
  "db_name": "PostgreSQL",
  "query": "SELECT g.id AS game_id, g.title AS game_title, t.id AS team_id,\n            t.name AS team_name, tm.is_captain\n        FROM rb_team_member tm\n        JOIN rb_team t ON t.id = tm.team_id\n        JOIN rb_game g ON g.id = tm.game_id\n        WHERE tm.user_id = $1\n        ORDER BY g.id, t.id",
