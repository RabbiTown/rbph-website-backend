  "query": "INSERT INTO rb_currency (cname, slug, growth, init_amount, prec, max_amount, game_id)\n        SELECT $2, $3, $4, $5, $6, $7, g.id\n        FROM rb_game g\n        WHERE g.id = $1\n        RETURNING id, cname AS name, slug, growth, init_amount, prec, max_amount;",
