  "query": "INSERT INTO rb_round (slug, sort, title, cover, game_id, puzzle)\n        SELECT $2, $3, $4, $5, g.id, NULL::INT\n        FROM rb_game g\n        WHERE g.id = $1 AND $6::INT IS NULL\n        RETURNING id, slug, sort, title, cover, game_id, puzzle;",
