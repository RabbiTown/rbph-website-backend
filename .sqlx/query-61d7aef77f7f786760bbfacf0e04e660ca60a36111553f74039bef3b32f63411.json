{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.slug, p.title, p.round_id, r.slug AS round_slug\n                FROM rb_puzzle p\n                JOIN rb_round r ON r.id = p.round_id\n                WHERE p.id = ANY($1)\n                ORDER BY r.sort, r.id, (p.id IS DISTINCT FROM r.puzzle), p.sort, p.id",
