{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.tname, t.bio, t.finish_at, MAX(tp.solve_at) AS last_solved_at,\n                COUNT(tp.puzzle_id) AS \"solves!\", t.game_id\n            FROM rb_team t\n            LEFT JOIN rb_team_puzzle tp ON tp.team_id = t.id AND tp.state = 1\n            WHERE t.id = $1\n            GROUP BY t.id;",
