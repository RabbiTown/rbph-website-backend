  "query": "SELECT t.id, t.name, t.is_locked\n        FROM rb_team t\n        JOIN rb_team_member tm ON tm.team_id = t.id\n        WHERE tm.user_id = $1 AND tm.game_id = $2 AND tm.is_captain\n        FOR UPDATE OF t;",
