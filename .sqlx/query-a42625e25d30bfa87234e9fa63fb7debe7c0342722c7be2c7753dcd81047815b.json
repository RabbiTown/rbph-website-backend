  "query": "SELECT re.id, re.occurred_at, rp.id AS phase_id\n        FROM rb_release_event re\n        JOIN rb_release_phase rp ON rp.id = re.phase_id\n        WHERE rp.game_id = $1 AND re.id > $2\n        ORDER BY re.id LIMIT 100;",
