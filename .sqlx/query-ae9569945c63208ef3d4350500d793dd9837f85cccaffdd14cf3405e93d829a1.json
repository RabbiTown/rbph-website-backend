{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.slug, p.round_id, r.puzzle AS round_puzzle_id\n        FROM rb_puzzle p\n        JOIN rb_round r ON r.id = p.round_id\n        WHERE r.game_id = $1\n        ORDER BY r.sort, r.id, (p.id IS DISTINCT FROM r.puzzle), p.sort, p.id;",
