  "query": "INSERT INTO rb_round (slug, sort, title, description, cover, game_id, puzzle)\n        SELECT $2, $3, $4, $5, $6, g.id, NULL::INT\n        FROM rb_game g\n        WHERE g.id = $1 AND $7::INT IS NULL\n        RETURNING id, slug, sort, title, description, cover, game_id, puzzle;",
