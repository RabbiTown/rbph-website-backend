  "query": "SELECT t.team_id, t.puzzle_id, tm.game_id,\n            p.round_id AS \"round_id?\", p.title AS \"puzzle_title?\"\n        FROM rb_ticket t\n        JOIN rb_team tm ON tm.id = t.team_id\n        LEFT JOIN rb_puzzle p ON p.id = t.puzzle_id\n        WHERE t.id = $1;",
