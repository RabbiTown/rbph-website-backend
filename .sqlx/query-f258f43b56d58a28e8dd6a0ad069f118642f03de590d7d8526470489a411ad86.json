  "query": "SELECT tk.id, p.id AS puzzle_id, p.title AS puzzle_title\n        FROM rb_ticket tk\n        JOIN rb_puzzle p ON p.id = tk.puzzle_id\n        WHERE tk.state = $1 AND tk.team_id = $2 AND tk.puzzle_id IS NOT NULL\n        ORDER BY tk.id DESC;",
